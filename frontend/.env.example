# =================================================================
# ARTS Frontend Environment Configuration Template
# =================================================================
# Copy this file to '.env' in the frontend/ directory for local overrides:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (Linux/macOS)
#
# NOTE: Frontend communicates exclusively via the Backend REST API.
# Database credentials and Supabase service keys MUST NEVER be placed here.
# =================================================================

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
