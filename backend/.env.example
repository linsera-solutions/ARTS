# =================================================================
# ARTS Backend Environment Configuration Template
# =================================================================
# Copy this file to '.env' in the backend/ directory for local development:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (Linux/macOS)
#
# IMPORTANT: Never commit '.env' or real credentials to Git.
# =================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ARTS API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Server Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =================================================================
# Supabase & PostgreSQL Connection Settings
# =================================================================
# Obtain these from your Supabase Project Settings:
# Project Settings -> Database -> Connection string (URI)
# Project Settings -> API -> Project URL & Project API Keys
# =================================================================

# Direct PostgreSQL Connection String (Session pooler port 5432 or Transaction pooler port 6543)
# Example: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase Anonymous Public API Key (client safe)
SUPABASE_KEY=

# Supabase Service Role Key (Backend administrative access ONLY - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=
