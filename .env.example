# =================================================================
# ARTS (Applicant Review & Team Selection System)
# Root Environment Reference Template
# =================================================================
# For local development, configure separate .env files in:
#   - backend/.env (for FastAPI and Supabase database settings)
#   - frontend/.env (for React API endpoint settings)
# =================================================================

# Backend Service
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase / PostgreSQL Credentials (Configured in backend/.env)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend Service (Configured in frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api/v1
